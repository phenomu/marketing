# MARKETING environment example — copy to .env (native) and edit values.
# NEVER commit the real .env. Container runs use the same variable names
# (docker-compose.yml injects them), so one variable set serves both worlds.

# --- application ---
APP_ENV=development            # development | production
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
DRY_RUN=true                    # ALWAYS true until real sending is explicitly approved
LOG_DIR=logs                    # relative to repo root; containers mount ./logs

# --- database (hybrid default: PostgreSQL in Docker, app native) ---
POSTGRES_USER=marketing
POSTGRES_PASSWORD=change-me     # required; used by both compose and native app
POSTGRES_DB=marketing
POSTGRES_HOST=127.0.0.1         # native: 127.0.0.1; container: db (compose overrides this)
POSTGRES_PORT=5432
# POSTGRES_BIND=127.0.0.1:5433  # uncomment when host 5432 is already taken
# DATABASE_URL=postgresql://user:pass@host:port/db  # optional: overrides POSTGRES_* parts

# --- services ---
BACKEND_URL=http://127.0.0.1:8000   # native default; dashboard-in-container uses http://api:8000
API_BIND=127.0.0.1:8000
DASHBOARD_BIND=127.0.0.1:8501
DASHBOARD_BACKEND_URL=http://api:8000  # what the dashboard calls from INSIDE compose network
WORKER_INTERVAL_S=30
SCHEDULER_INTERVAL_S=60

# --- SMTP (outreach; leave empty until PHASE 6) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_NAME=MARKETING
