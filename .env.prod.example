# MARKETING — production environment template (PHASE 9).
#
# Copy to .env (or .env.prod — see docs/DEPLOYMENT.md) on the server and
# fill in EVERY value marked REQUIRED. This file is committed WITHOUT
# secrets; the real file must never be committed (gitignored as .env*).
#
# Rule of thumb for secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- core ---------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
LOG_DIR=logs

# --- database (REQUIRED) ------------------------------------------------------
POSTGRES_PASSWORD=            # strong random — same value as in compose
# POSTGRES_USER=marketing
# POSTGRES_HOST=db             # db inside the compose network
# POSTGRES_PORT=5432
# POSTGRES_DB=marketing
# DATABASE_URL=                # or a full URL instead of the parts above

# --- outreach safety (REQUIRED before any live sending) -----------------------
# Live sending needs ALL THREE: DRY_RUN=false + SMTP creds + OUTREACH_SEND_LIVE=true
# (D-036 — deliberately awkward so live send can never happen by accident)
DRY_RUN=true                  # keep true until SMTP is tested end to end
OUTREACH_SEND_LIVE=false      # arm live sending LAST
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SENDER_NAME=

# --- security (REQUIRED when any port is reachable beyond 127.0.0.1) ----------
# Gates BOTH the FastAPI backend (X-Auth-Token / Bearer) and the Streamlit
# dashboard (?token=...). Empty = auth off (localhost only!).
API_AUTH_TOKEN=               # python -c "import secrets; print(secrets.token_urlsafe(32))"

# HMAC secret for unsubscribe links (D-037). Links already sent keep working
# only while this value stays the same — set once, never rotate casually.
UNSUBSCRIBE_SECRET=           # python -c "import secrets; print(secrets.token_urlsafe(32))"

# Base URL of the PUBLIC api as seen by email recipients (unsubscribe links):
UNSUBSCRIBE_BASE_URL=https://api.example.com

# --- discovery sources (optional) ---------------------------------------------
SERPAPI_KEY=
GOOGLE_PLACES_API_KEY=

# --- crawl politeness ----------------------------------------------------------
CRAWL_DELAY_S=5
CRAWL_MAX_PAGES=10
CRAWL_TIMEOUT_S=15
CRAWL_RETRIES=2
CRAWL_USER_AGENT=marketing-research-bot/0.1 (+contact discovery; respects robots.txt)

# --- outbound rate limits -------------------------------------------------------
OUTREACH_SEND_PER_DAY=50      # provider limit + reputation: keep LOW
OUTREACH_BATCH_LIMIT=10
